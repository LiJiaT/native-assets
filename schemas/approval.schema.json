{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset approval binding",
  "type": "object",
  "required": ["schema_version", "asset_id", "proposal_id", "record_path", "record_sha256", "content_sha256", "approver", "decision", "approved_at", "scope"],
  "properties": {
    "schema_version": {"const": "1"},
    "asset_id": {"type": "string", "pattern": "^EA-[0-9]{8}-[0-9]{2,}$"},
    "proposal_id": {"type": "string"},
    "record_path": {"type": "string"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approver": {"type": "string", "minLength": 2},
    "approver_role": {"type": "string"},
    "decision": {"enum": ["approved", "rejected", "needs-revision"]},
    "approved_at": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["layer", "projects", "domains", "ai_form", "owner", "provenance_status", "release_channel"]
    },
    "release_channel": {"enum": ["component-library", "personal", "test-only"]},
    "basis": {"type": "string"},
    "binding_note": {"type": "string"}
  }
}
